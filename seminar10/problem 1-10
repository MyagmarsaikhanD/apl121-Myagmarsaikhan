//problem 3  return max of 3
int max3(int a, int b, int c) {
    int max = a;

    if (b > max)
        max = b;

    if (c > max)
        max = c;

    return max;
}


//problem 4 return even/odd
int is_even(int n) {
if (n%2==0)
return 1;
else 
return 0;
}

//problem 5 return abs
int absolute(int x) {
if(x<0)
return -x;
else
return x;
}


//problem 6 return circle area
double circle_area(double r) {
return r*r*3.14159265358979;
}


//problem 7  print line
void print_line(int n, char c) {
    for (int i = 0; i < n; i++) {
        printf("%c", c);
    }
    printf("\n");
}

//problem 8 sign
int sign(int x) {
if (x>0)
return 1;
else if (x==0)
return 0;
else return -1;
}

//problem 9 average of 3 
double avg3(int a, int b, int c) {
int sum=a+b+c;
return sum/3.0;
}


//problem 10 last digit 
int last_digit(int n) {
    int digit = n % 10;
    if (digit < 0)
        digit = -digit;
    return digit;
}





