#include <stdio.h>

int min_of(int a[], int n);
int max_of(int a[], int n);
double mean_of(int a[], int n);

int main() {
    int n, a[100];
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    printf("%d %d %.2f\n", min_of(a, n), max_of(a, n), mean_of(a, n));

    return 0;
}

int min_of(int a[], int n) {
    int min = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] < min)
            min = a[i];
    }
    return min;
}

int max_of(int a[], int n) {
    int max = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] > max)
            max = a[i];
    }
    return max;
}

double mean_of(int a[], int n) {
    double sum = 0;
    for (int i = 0; i < n; i++) {
        sum += a[i];
    }
    return sum / n;
}
