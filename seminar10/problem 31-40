//problem 36 
long long fib(int n) {
    long long a = 0, b = 1, c;
    for (int i = 0; i < n; i++) {
        c = a + b;
        a = b;
        b = c;
    }
    return a;
}


//problem 37 
int is_armstrong(int n) {
    int temp = n, digits = 0, sum = 0;
    do {
        digits++;
        temp /= 10;
    } while (temp > 0);
    temp = n;
    do {
        int digit = temp % 10;
        int power = 1;
        for (int i = 0; i < digits; i++) {
            power *= digit;
        }
        sum += power;
        temp /= 10;
    } while (temp > 0);
    return sum == n;
}


//problem 38
void reverse_array(int a[], int n) {
    for (int i = 0; i < n / 2; i++) {
        int temp = a[i];
        a[i] = a[n - 1 - i];
        a[n - 1 - i] = temp;
    }
}

