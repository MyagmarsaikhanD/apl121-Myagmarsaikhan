//problem 31 
int is_prime(int n) {
    if (n < 2)
        return 0;
    for (int i = 2; i <= n / i; i++) {
        if (n % i == 0)
            return 0;
    }
    return 1;
}
int next_prime(int n) {
    int num = n + 1;

    while (!is_prime(num)) {
        num++;
    }
    return num;
}

//problem 32
int is_prime(int n) {
    if (n < 2)
        return 0;
    for (int i = 2; i <= n / i; i++) {
        if (n % i == 0)
            return 0;
    }
    return 1;
}
int count_primes(int a, int b) {
    int count = 0;
    for (int i = a; i <= b; i++) {
        if (is_prime(i))
            count++;
    }
    return count;
}

//problem 33
int binary_to_decimal(long long b) {
    int decimal = 0;
    int base = 1;
    while (b > 0) {
        decimal += (b % 10) * base;
        b /= 10;
        base *= 2;
    }
    return decimal;
}

//problem 34
long long decimal_to_binary(int n) {
    long long binary = 0;
    long long place = 1;
    while (n > 0) {
        binary += (n % 2) * place;
        n /= 2;
        place *= 10;
    }
    return binary;
}

