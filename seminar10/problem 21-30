//problem 23
int count_divisors(int n) {
    int count = 0;

    for (int i = 1; i <= n; i++) {
        if (n % i == 0)
            count++;
    }

    return count;
}

//problem 24
int is_perfect(int n) {
    int sum = 0;

    for (int i = 1; i < n; i++) {
        if (n % i == 0)
            sum += i;
    }

    if (sum == n)
        return 1;
    else
        return 0;
}

//problem 25 
int array_sum(int a[], int n) {
    int sum = 0;

    for (int i = 0; i < n; i++) {
        sum += a[i];
    }

    return sum;
}

// problem 26
int array_max(int a[], int n) {
    int max = a[0];

    for (int i = 1; i < n; i++) {
        if (a[i] > max)
            max = a[i];
    }

    return max;
}

//problem 27 
double array_avg(int a[], int n) {
    double sum = 0;

    for (int i = 0; i < n; i++) {
        sum += a[i];
    }

    return sum / n;
}

//problem 28 
int index_of(int a[], int n, int key) {
    for (int i = 0; i < n; i++) {
        if (a[i] == key)
            return i;
    }
    return -1;
}

//problem 29 
void print_array(int a[], int n) {
    for (int i = 0; i < n; i++) {
        if (i > 0)
            printf(" ");
        printf("%d", a[i]);
    }
    printf("\n");
}


