#include <stdio.h>

long long paths(int r, int c) {
    if (r == 1 || c == 1) return 1;

    return paths(r - 1, c) + paths(r, c - 1);
}

int main(void) {
    int r, c;

    if (scanf("%d %d", &r, &c) != 2) return 1;
    if (r < 1 || r > 15 || c < 1 || c > 15) return 1;

    printf("%lld\n", paths(r, c));
    return 0;
}
